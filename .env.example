# Copy to .env and fill in locally. Never commit .env. Names only, no values here.
# Every variable below is read by the code. Postgres, Redis, and OTel are not wired (design.md D4, D5, S2).

# LLM. Optional: without a key, generation uses the extractive fallback (design.md D8).
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-haiku-5-5
GENERATION_MODEL=claude-sonnet-5-5

# Runtime
DEFAULT_TENANT_ID=tenant_a
# 1 = enforce the 120 ms step and 450 ms loop budgets (use on target hardware; design.md D20)
ENFORCE_TIME_BUDGETS=0
