# Copy to .env and fill in locally. Never commit .env. Names only, no values here.
# Every variable below is read by the code. Postgres, Redis, and OTel are not wired (design.md D4, D5, S2).

# LLM provider. OpenRouter is the default when its key is set (design.md D8, D25).
# With no key, generation and triage use the local rules and extractive fallback.
OPENROUTER_API_KEY=
# Generation model (default anthropic/claude-sonnet-5.5) and triage model (default anthropic/claude-haiku-5.5).
# Prices are in app/config.py (OPENROUTER_PRICES), taken from the OpenRouter model list (design.md D29).
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_TRIAGE_MODEL=anthropic/claude-haiku-5.5

# Optional alternative provider (design.md D25). Used only when OPENROUTER_API_KEY is empty.
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-haiku-5-5
GENERATION_MODEL=claude-sonnet-5-5

# Runtime
DEFAULT_TENANT_ID=tenant_a
# 1 = enforce the 120 ms step and 450 ms loop budgets (use on target hardware; design.md D20)
ENFORCE_TIME_BUDGETS=0
